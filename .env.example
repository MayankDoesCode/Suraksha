# SentinelShield Platform Configuration
# Copy this file to .env for local development

# Environment: development, testing, production
FLASK_ENV=development
FLASK_DEBUG=1

# Server Bindings
PORT=5000
HOST=127.0.0.1

# Database Connection
# SQLite for local development: sqlite:///sentinelshield.db
# PostgreSQL for production: postgresql://user:password@localhost:5432/sentinelshield
DATABASE_URL=sqlite:///sentinelshield.db

# Security & CORS
SECRET_KEY=change-me-in-production-use-a-strong-random-key
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Application Limits
MAX_CONTENT_LENGTH=5242880  # 5MB in bytes

# Logging Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Future Integrations (Phase 2+) - Placeholders only
# GROQ_API_KEY=
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=sentinelshield

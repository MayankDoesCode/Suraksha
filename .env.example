# SURAKSHA Platform Configuration
# Copy this file to .env for local development

# Environment: development, testing, production
FLASK_ENV=development
FLASK_DEBUG=1

# Server Bindings
PORT=5000
HOST=127.0.0.1

# Database Connection
# SQLite for local development: sqlite:///sentinelshield.db
# PostgreSQL for production: postgresql://user:password@localhost:5432/sentinelshield
DATABASE_URL=sqlite:///sentinelshield.db

# Security & CORS
SECRET_KEY=change-me-in-production-use-a-strong-random-key
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Application Limits
MAX_CONTENT_LENGTH=5242880  # 5MB in bytes

# Logging Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# External Data Providers (Phase 4)
# Apple App Store (iTunes API - Public authorized REST API, no key required)
ITUNES_STORE_COUNTRY=US
ITUNES_API_TIMEOUT=10

# Twitter / X API v2 (Requires Project & App Bearer Token from developer.x.com)
# X_BEARER_TOKEN=
X_API_TIMEOUT=10

# Frontend Firebase Web Authentication & Firestore Configuration (Phase 2)
# Obtain these values from Firebase Console > Project Settings > General > Your apps (Web app)
VITE_API_BASE_URL=/api/v1
VITE_FIREBASE_API_KEY=AIzaSyPlaceholderAPIKeyForDevelopment000
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=(default)

# Groq AI Investigation Provider (Server-Side Only - Never Expose to Frontend)
# GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=15.0
GROQ_MAX_RETRIES=2

# LangSmith Tracing & Evaluation (Server-Side Only)
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=lsv2_pt_your_langsmith_api_key_here
LANGSMITH_PROJECT=suraksha-investigations
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

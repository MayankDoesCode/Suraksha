# SURAKSHA Frontend Client Configuration
# Copy this file to frontend/.env for local development

# API Base URL (defaults to /api/v1 via Vite dev proxy)
VITE_API_BASE_URL=/api/v1

# Firebase Web App Configuration
# Obtain these values from Firebase Console > Project Settings > General > Your apps (Web app)
VITE_FIREBASE_API_KEY=AIzaSyPlaceholderAPIKeyForDevelopment000
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=(default)
